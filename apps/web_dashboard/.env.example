# Frontend env vars (build-time, prefix VITE_).
# Task 11 introduces Zod-validated env loader (src/lib/env.ts).
VITE_API_BASE_URL=/api/v1
# Formulário de contato: POST ${VITE_API_BASE_URL}/public/leads (endpoint a prover em central_api).

# Runtime policy: generic (default; empty = absent) | production.
# production requires VITE_API_BASE_URL=https://api.cnesdata.com.br/api/v1 and VITE_AUTH_MODE=oidc.
# VITE_RUNTIME_POLICY=generic

# OIDC (Task 12 — leave commented in v1.0 dev until Keycloak runs).
# VITE_OIDC_AUTHORITY=http://localhost:8080/realms/cnesdata
# VITE_OIDC_CLIENT_ID=cnesdata-dashboard
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

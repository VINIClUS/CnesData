# CnesData local development environment.
# Copy to `.env` and replace secrets/paths as needed.
# Do not commit real credentials.

# ---------------------------------------------------------------------------
# Central Postgres
# ---------------------------------------------------------------------------
DB_URL=postgresql+psycopg://cnesdata:cnesdata_test@localhost:5433/cnesdata_test

# ---------------------------------------------------------------------------
# Tenant / municipality defaults
# ---------------------------------------------------------------------------
COD_MUN_IBGE=354130
ID_MUNICIPIO_IBGE7=3541307
CNPJ_MANTENEDORA=55293427000117
COMPETENCIA_ANO=2026
COMPETENCIA_MES=1

# ---------------------------------------------------------------------------
# Central API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
AUTH_REQUIRED=required
ADMIN_TOKEN=local-admin
# Direct/local HTTP use; enable only when a trusted TLS-terminating proxy is in front.
TRUST_X_FORWARDED_PROTO=false
# CIDRs (separados por vírgula) de proxies confiáveis para X-Forwarded-For no rate limiter.
# Vazio = nunca confiar em XFF (usa sempre o IP do socket). Direct/local HTTP use; deixe vazio.
TRUSTED_PROXY_CIDRS=
# Origens do dashboard autorizadas no CORS do central_api (sem *). Vazio = nenhuma origem cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Limite do POST /api/v1/public/leads por IP (formato slowapi).
LEADS_RATE_LIMIT=5/minute
DASHBOARD_OIDC_ISSUER=http://localhost:8080/realms/cnesdata
DASHBOARD_OIDC_AUDIENCE=cnesdata-dashboard

# Device flow + mTLS provisioning.
# For local dev, point these to a test CA generated outside the repo.
# AUTH_CA_CERT_PATH=secrets/ca.crt
# AUTH_CA_KEY_PATH=secrets/ca.key
AUTH_DEVICE_VERIFICATION_URI=http://localhost:5173/activate
AUTH_DEVICE_CODE_TTL=600
AUTH_ACCESS_TOKEN_TTL=300
AUTH_CERT_TTL_DAYS=90
# /api/v1/jobs/* exigem o cert do agente repassado pelo Caddy (X-SSL-Client-Cert,
# só aceito de TRUSTED_PROXY_CIDRS). Só "false" desliga — stack local sem Caddy.
AGENT_MTLS_REQUIRED=true

# ---------------------------------------------------------------------------
# Object storage (S3 API — S3 real em produção, MinIO AIStor em dev, LocalStack
# em CI). Credenciais via AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (cadeia
# padrão do boto3), não geridas por este arquivo.
# ---------------------------------------------------------------------------
S3_REGION=sa-east-1
S3_BUCKET=cnesdata-landing
S3_ENDPOINT_URL=http://localhost:9000
S3_ADDRESSING_STYLE=path
# Host usado nas URLs presigned entregues ao edge agent; default =
# S3_ENDPOINT_URL. Só importa contra um backend self-hosted (dev/CI) —
# S3 real já é público, produção não seta.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ---------------------------------------------------------------------------
# Data processor
# ---------------------------------------------------------------------------
PROCESSOR_ID=processor-01
PROCESSOR_POLL_INTERVAL=5.0
PROCESSOR_IDLE_POLL_INTERVAL=60.0

# ---------------------------------------------------------------------------
# Perfil aws (PROFILE=aws) — central_api e data_processor sobre DynamoDB, S3 e
# Step Functions. Tudo comentado: `.env` é carregado no import de
# cnes_infra.config, e linhas ativas tirariam o processo do caminho legado.
# Credenciais vêm só da provider chain do boto3 (role da task ECS); não há chave
# estática. PROFILE=aws recusa RAW_BACKEND e RAW_AWS_* no mesmo processo.
# DB_URL continua obrigatório no import de cnes_infra.config (placeholder, não
# usado neste perfil).
# O task agendado `recover-once` não recebe TENANT_ID, RUN_ID, WAVE_ID,
# DISPATCH_ID, UNIT_ID, EXECUTION_OWNER nem LEASE_SECONDS: qualquer uma delas
# sem UNIT_ID é envelope parcial e o task falha.
# ---------------------------------------------------------------------------
# PROFILE=aws
# AUTH_MODE=oidc
# AWS_REGION=us-east-2
# AWS_CONTROL_PLANE_TABLE=cnesdata-control-plane
# AWS_DATA_BUCKET=cnesdata-data
# AWS_AUDIT_BUCKET=cnesdata-audit
# AWS_STATE_MACHINE_ARN=arn:aws:states:us-east-2:<conta>:stateMachine:cnesdata-processor
# AWS_PROCESSOR_CONTAINER_NAME=processor
# AWS_PROCESSOR_MAX_CONCURRENCY=8
# AWS_PROCESSOR_LEASE_SECONDS=300
# AWS_PROCESSOR_RECOVERY_BATCH_SIZE=100
# AWS_SERVING_URL_TTL_SECONDS=300
# AWS_AUDIT_RETENTION_DAYS=<dias definidos na spec de deploy>
# OIDC_ISSUER=https://<issuer>
# OIDC_AUDIENCE=cnesdata-dashboard
# Emulador aws-test (`docker compose --profile aws-test`: dynamodb-local e
# localstack). Produção deixa as duas vazias. O botocore também lê
# AWS_ENDPOINT_URL para qualquer cliente sem endpoint explícito.
# DYNAMODB_ENDPOINT_URL=http://127.0.0.1:18000
# AWS_ENDPOINT_URL=http://127.0.0.1:4566

# ---------------------------------------------------------------------------
# Edge agent (Go)
# ---------------------------------------------------------------------------
CENTRAL_API_URL=http://localhost:8000
TENANT_ID=354130
MACHINE_ID=agent-01
MAX_JITTER_SECONDS=5
# INTENT and TIPO_EXTRACAO default to cnes_estabelecimentos (matches
# central_api's _FATO_SUBTYPE_FOR) — override both together, same value,
# for cnes_profissionais/cnes_equipes.
# INTENT=cnes_estabelecimentos
# TIPO_EXTRACAO=cnes_estabelecimentos

# Fleet rollout escape hatch. Remove for production.
# AGENT_ALLOW_INSECURE=true

# Override agent auth directory during local tests.
# AGENT_AUTH_DIR=.cache/agent-auth

# ---------------------------------------------------------------------------
# Local source paths for edge/dev ingestion
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PATH=C:\Datasus\CNES\CNES.GDB
DB_USER=SYSDBA
DB_PASSWORD=masterkey
FIREBIRD_DLL=C:\caminho\para\fbclient.dll
# FIREBIRD_LIB=/path/to/libfbclient.so

BPA_GDB_PATH=C:\Datasus\BPA\BPAMAG.GDB
SIA_DIR=C:\Datasus\SIA
FBCLIENT_PATH=C:\firebird-1.5.6\bin\fbclient.dll

# National CNES / BigQuery.
GCP_PROJECT_ID=seu-projeto-gcp

# Optional OTel.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

          "raw_subtype": "DIM_SIGTAP"
        },
        {
          "doc_id": "sia-normalized-dim-municipio",
          "oracle": {"file": "expected_normalized.json", "path": ["DIM_MUNICIPIO", "data"]},
          "candidate": {"layer": "normalized", "leaf": "reference_municipio.parquet"},
          "row_key": ["_source_row"],
          "raw_subtype": "DIM_MUNICIPIO"
        },
        {
          "doc_id": "sia-normalized-quality-dim-municipio",
          "oracle": {"file": "expected_normalized.json", "path": ["DIM_MUNICIPIO", "quality"]},
          "candidate": {"layer": "normalized", "leaf": "quality_issues_dim_municipio.parquet"},
          "row_key": ["_source_row", "issue_code"],
          "raw_subtype": "DIM_MUNICIPIO"
        },
        {
          "doc_id": "sia-serving-overview",
          "oracle": {"file": "expected_serving.json", "path": ["overview"]},
          "candidate": {"layer": "serving", "leaf": "overview.json"}
        },
        {
          "doc_id": "sia-serving-by-establishment",
          "oracle": {"file": "expected_serving.json", "path": ["by-establishment"]},
          "candidate": {"layer": "serving", "leaf": "by-establishment.json"},
          "list_keys": {"estabelecimentos": ["cnes"]}
        }
      ]
    }
  },
  "rules": [
    {
      "rule_id": "MIG010-RUN-ID",
      "metrics": ["*-serving-*::run_id"],
      "check": "candidate_equals_context",
      "context": "version_id",
      "absent_ok": false,
      "rationale": "O oraculo congelou o run_id de outra execucao; o candidato deve carregar o version_id do DatasetPointer ativo."
    },
    {
      "rule_id": "MIG010-GENERATED-AT",
      "metrics": ["*-serving-*::generated_at"],
      "check": "candidate_equals_context",
      "context": "clock_z",
      "absent_ok": false,
      "rationale": "CND-002 declara run_id e generated_at volateis; o candidato deve carregar o relogio injetado na forma Z."
    },
    {
      "rule_id": "MIG010-NORMALIZED-AT",
      "metrics": ["*-normalized-*::[*]._normalized_at"],
      "check": "candidate_equals_context",
      "context": "clock_offset",
      "absent_ok": false,
      "rationale": "Os oraculos congelaram relogios proprios (o bpa tem 12:00 no normalizado e 14:00 no serving); o candidato deve carregar o relogio injetado em +00:00."
    },
    {
      "rule_id": "MIG010-CNES-NORMALIZED-IDS",
      "metrics": ["cnes-gold::[*]._source_manifest_ids[*]", "cnes-divergences::[*].source_manifest_ids[*]"],
      "check": "candidate_equals_context_by_legacy",
      "context": {
        "fixture-cnes-local-v1": "normalized_id/CNES_LOCAL",
        "fixture-cnes-nacional-v1": "normalized_id/CNES_NACIONAL"
      },
      "absent_ok": false,
      "rationale": "CND-054 manifest_ids_are_normalized_layer: o pipeline referencia o manifest normalizado de cada fonte, nao o raw congelado na fixture."
    },
    {
      "rule_id": "MIG010-CNES-DIVERGENCE-TEXT",
      "metrics": [
        "cnes-divergences::[*].local_value",
        "cnes-divergences::[*].national_value",
        "cnes-divergences::[*].selected_value"
      ],
      "check": "candidate_is_text_of_legacy_int",
      "context": null,
      "absent_ok": false,
      "rationale": "CND-054 divergence_values_are_strings: o Parquet de divergencias tem colunas String; o valor legado inteiro deve aparecer como seu texto decimal."
    },
    {
      "rule_id": "MIG010-SIA-RAW-MANIFEST-SHA256",
      "metrics": ["sia-normalized-*::[*]._source_manifest_sha256"],
      "check": "candidate_equals_context",
      "context": "raw_manifest_sha256/{doc}",
      "absent_ok": true,
      "rationale": "O oraculo sia declara _source_manifest_sha256 volatil e o omite; o candidato deve carregar o sha256 do manifest raw semeado para o subtipo do documento."
    }
  ]
}

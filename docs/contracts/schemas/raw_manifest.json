{
  "$defs": {
    "SnapshotMode": {
      "enum": [
        "FULL",
        "DELTA"
      ],
      "title": "SnapshotMode",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "CNES_LOCAL",
        "CNES_NACIONAL",
        "SIHD",
        "BPA_MAG",
        "SIA_LOCAL"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "agent_version": {
      "minLength": 1,
      "title": "Agent Version",
      "type": "string"
    },
    "base_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Base Snapshot Id"
    },
    "competencia": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "title": "Competencia",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "file_subtype": {
      "minLength": 1,
      "title": "File Subtype",
      "type": "string"
    },
    "manifest_id": {
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_version": {
      "const": 1,
      "title": "Manifest Version",
      "type": "integer"
    },
    "object_key": {
      "minLength": 1,
      "title": "Object Key",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "previous_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Manifest Sha256"
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_mode": {
      "$ref": "#/$defs/SnapshotMode"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "manifest_version",
    "manifest_id",
    "tenant_id",
    "source_type",
    "file_subtype",
    "competencia",
    "agent_id",
    "agent_version",
    "schema_version",
    "snapshot_mode",
    "snapshot_id",
    "base_snapshot_id",
    "sequence",
    "previous_manifest_sha256",
    "object_sha256",
    "row_count",
    "size_bytes",
    "object_key",
    "created_at"
  ],
  "title": "RawManifest",
  "type": "object"
}

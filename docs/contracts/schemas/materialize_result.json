{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "OutputManifest": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "exclusiveMinimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "competencia": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "title": "Competencia",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "layer": {
          "enum": [
            "normalized",
            "reconciliation",
            "serving"
          ],
          "title": "Layer",
          "type": "string"
        },
        "manifest_id": {
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "manifest_version": {
          "const": 1,
          "title": "Manifest Version",
          "type": "integer"
        },
        "object_key": {
          "minLength": 1,
          "title": "Object Key",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceType"
            },
            {
              "type": "null"
            }
          ]
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "manifest_version",
        "manifest_id",
        "tenant_id",
        "layer",
        "source_type",
        "competencia",
        "run_id",
        "unit_id",
        "attempt",
        "schema_version",
        "object_key",
        "object_sha256",
        "row_count",
        "created_at"
      ],
      "title": "OutputManifest",
      "type": "object"
    },
    "ServingDocument": {
      "additionalProperties": false,
      "properties": {
        "document_name": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Document Name",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[a-z0-9-]+-v[1-9][0-9]*$",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "document_name",
        "tenant_id",
        "run_id",
        "generated_at",
        "payload"
      ],
      "title": "ServingDocument",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "CNES_LOCAL",
        "CNES_NACIONAL",
        "SIHD",
        "BPA_MAG",
        "SIA_LOCAL"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/ServingDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "manifests": {
      "items": {
        "$ref": "#/$defs/OutputManifest"
      },
      "title": "Manifests",
      "type": "array"
    }
  },
  "required": [
    "manifests",
    "documents"
  ],
  "title": "MaterializeResult",
  "type": "object"
}

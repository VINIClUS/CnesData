# Reference only. The real /opt/cnesdata-dev/.env on the VPS is generated by
# bootstrap.sh with random secrets and is never committed. IMAGE_TAG lives in
# a separate .env.image file, rewritten by deploy.sh on every deploy.

POSTGRES_USER=cnesdata
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cnesdata
DB_URL=postgresql+psycopg://cnesdata:changeme@postgres:5432/cnesdata

MINIO_ROOT_USER=cnesdata-dev
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cnesdata-dev
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false
MINIO_BUCKET=cnesdata-landing-dev

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

PUBLIC_DOMAIN=dev.cnesdata.vinisantana.com
DASHBOARD_OIDC_ISSUER=https://dev.cnesdata.vinisantana.com/idp/realms/cnesdata
DASHBOARD_OIDC_AUDIENCE=cnesdata-dashboard
AUTH_DEVICE_VERIFICATION_URI=https://dev.cnesdata.vinisantana.com/activate
AUTH_REQUIRED=required

COD_MUN_IBGE=354130
ID_MUNICIPIO_IBGE7=3541308
CNPJ_MANTENEDORA=55293427000117
COMPETENCIA_ANO=2026
COMPETENCIA_MES=1

PROCESSOR_POLL_INTERVAL=5.0
PROCESSOR_IDLE_POLL_INTERVAL=60.0

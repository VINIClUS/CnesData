# Reference only. The real /opt/cnesdata-dev/.env on the VPS is generated by
# bootstrap.sh with random secrets and is never committed. IMAGE_TAG lives in
# a separate .env.image file, rewritten by deploy.sh on every deploy.

POSTGRES_USER=cnesdata
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cnesdata
DB_URL=postgresql+psycopg://cnesdata:changeme@postgres:5432/cnesdata

# AIStor Free (successor to MinIO). Get a license at https://min.io/pricing
# and place it at /opt/cnesdata-dev/secrets/minio.license (never committed).
# App services reuse MINIO_ROOT_USER/PASSWORD as their S3 credentials —
# S3_ENDPOINT_URL is hardcoded to http://minio:9000 in the compose file.
MINIO_ROOT_USER=cnesdata-dev
MINIO_ROOT_PASSWORD=changeme
S3_BUCKET=cnesdata-landing-dev
RAW_DYNAMODB_TABLE=cnesdata-raw-dev
RAW_S3_BUCKET=cnesdata-raw-dev-836651842853
RAW_AWS_REGION=sa-east-1
RAW_AWS_ACCESS_KEY_ID=
RAW_AWS_SECRET_ACCESS_KEY=
# Host embedded in presigned URLs handed to the edge agent — minio:9000 is a
# Docker-internal alias, unreachable off-host. Requires the DNS A record and
# the Caddy storage.dev.* vhost (deploy/prod/caddy/Caddyfile) to exist first.
S3_PUBLIC_ENDPOINT_URL=https://storage.dev.cnesdata.com.br

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

PUBLIC_DOMAIN=dev.cnesdata.com.br
# Host público da API (Caddy → central-api). CORS do central-api aceita só PUBLIC_DOMAIN.
API_DOMAIN=api.dev.cnesdata.com.br
# Limite do formulário público de leads (slowapi, por IP atrás do proxy).
LEADS_RATE_LIMIT=5/minute
# Pré-lançamento: true mantém X-Robots-Tag: noindex em /precos. false libera indexação.
# A meta robots do HTML é build-time (VITE_PRECOS_NOINDEX nos workflows de deploy).
PRECOS_NOINDEX=true
DASHBOARD_OIDC_ISSUER=https://dev.cnesdata.com.br/idp/realms/cnesdata
DASHBOARD_OIDC_AUDIENCE=cnesdata-dashboard
AUTH_DEVICE_VERIFICATION_URI=https://dev.cnesdata.com.br/activate
AUTH_REQUIRED=required
# X-Admin-Token for /api/v1/admin/* and /extractions/enqueue; empty disables them (503).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
# Caddy terminates TLS and forwards X-Forwarded-Proto to central-api.
TRUST_X_FORWARDED_PROTO=true
# Bridge network dos containers do compose (Caddy/nginx) — único caminho até central-api.
# 172.16.0.0/12 cobre o pool default do Docker (172.17.0.0/16-172.31.0.0/16), mas
# `cnesdata_edge` é external — confirme o subnet real antes do deploy:
# `docker network inspect cnesdata_edge --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'`
# e ajuste este valor se divergir.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

COD_MUN_IBGE=354130
ID_MUNICIPIO_IBGE7=3541308
CNPJ_MANTENEDORA=55293427000117
COMPETENCIA_ANO=2026
COMPETENCIA_MES=1

PROCESSOR_POLL_INTERVAL=5.0
PROCESSOR_IDLE_POLL_INTERVAL=60.0

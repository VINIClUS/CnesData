# Runs in the `caddy` service of docker-compose.prod.yml. This is the only
# public entrypoint on the VPS (ports 80/443) — it also proxies
# dev.cnesdata.com.br via the shared `cnesdata_edge` network, so the
# `develop` block below must never be dropped when redeploying prod.
# See docs/runbooks/deploy-develop.md for how that block was added.
#
# Prod's own domain cutover (.env, deployed image, DNS, Keycloak client)
# completed 2026-09-22 — see docs/runbooks/deploy-main.md, "Pré-requisito
# manual: migração de domínio" for the full sequencing this file's history
# depends on. Between 2026-09-19 and 2026-09-22 the two prod blocks below
# dual-served the new (cnesdata.com.br) and legacy (vinisantana.com)
# hostnames from the same backend: dropping the legacy names before the
# cutover completed caused a live ~30min outage on 2026-09-22 (this file
# was renamed in place, Caddy lost its only block for
# cnesdata.vinisantana.com/api.vinisantana.com, every request
# TLS-handshake-failed). The legacy hostnames were removed here — along
# with their DNS records and Keycloak client entries — only after
# confirming the new domain's CSP/smoke/login+logout all passed. If a
# future domain migration needs the same dual-serve step, do not just add
# both hostnames to one `handle` block long-term: once the new build's
# VITE_OIDC_REDIRECT_URI is live, a login started on the legacy origin
# stores its OIDC state there but gets redirected to the new origin's
# callback, which can't read state from a different origin — keep the
# dual-serve window short and remove the legacy name as soon as verified.

cnesdata.com.br {
    handle /idp/* {
        reverse_proxy keycloak:8080
    }
    handle {
        reverse_proxy web-dashboard:80
    }
}

dev.cnesdata.com.br {
    handle /idp/* {
        reverse_proxy dev-keycloak:8080
    }
    handle {
        reverse_proxy dev-web-dashboard:80
    }
}

# API hosts: only the versioned API surface is exposed; docs/openapi stay internal.
api.cnesdata.com.br {
    handle /api/* {
        reverse_proxy central-api:8000
    }
    handle {
        respond 404
    }
}

api.dev.cnesdata.com.br {
    handle /api/* {
        reverse_proxy dev-central-api:8000
    }
    handle {
        respond 404
    }
}

# Edge agent upload target for dev (self-hosted AIStor/MinIO). Prod has no
# equivalent block: prod's compose removes the minio service entirely and
# presigned URLs point straight at real S3, which is already public. An
# earlier prod-side storage.cnesdata.com.br vhost (reverse_proxy
# minio:9000) was dropped here — that minio service no longer exists on
# prod, so the vhost was dead config. If Caddy already issued a Let's
# Encrypt cert for it, the cert sits unused in caddy_data; harmless.
storage.dev.cnesdata.com.br {
    reverse_proxy dev-minio:9000
}
